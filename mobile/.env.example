# Where the app finds the API. There is deliberately no default: a debug build
# silently pointing at production is how test data ends up in real accounts.
#
# Production:  https://your-domain
# Simulator:   http://localhost:3100
# Real device: http://<your Mac's LAN IP>:3100 — "localhost" on an iPhone means
#              the iPhone.
EXPO_PUBLIC_API_URL=
