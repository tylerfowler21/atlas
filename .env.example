# Local dev: `npm run db:dev` starts a Postgres on this URL with no install.
# Production: the connection string from your hosted Postgres (Neon, Supabase,
# Vercel Postgres, …).
# Local dev needs no TLS. For a hosted database always end the URL with
# ?sslmode=verify-full so the certificate and hostname are checked.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55432/postgres"

# Any long random string. Generate one with: openssl rand -base64 33
AUTH_SECRET=""

# Google Cloud → APIs & Services → Credentials → OAuth client ID (Web).
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# DEVELOPMENT ONLY. Enables a passwordless "sign in as any email" button so
# multi-user behaviour can be tested without Google credentials. It is ignored
# in production builds, but never set it on a deployed environment.
ALLOW_DEV_LOGIN="false"

# Comma-separated emails allowed to see /admin, the "who is using this"
# page. Leave unset and nobody can reach it.
ADMIN_EMAILS=""

# Vercel Blob, for journal photos. Create a Blob store in the Vercel dashboard
# and copy the token from its .env.local tab. Without it the app runs fine and
# photo upload reports that storage isn't configured.
#
# Do NOT also set BLOB_STORE_ID locally: with it plus a VERCEL_OIDC_TOKEN in
# .env.local, the SDK switches to OIDC auth, ignores this token, and fails
# because OIDC is not enabled for development.
BLOB_READ_WRITE_TOKEN=""
