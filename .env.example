# Local dev: `npm run db:dev` starts a Postgres on this URL with no install.
# Production: the connection string from your hosted Postgres (Neon, Supabase,
# Vercel Postgres, …).
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55432/postgres"

# Any long random string. Generate one with: openssl rand -base64 33
AUTH_SECRET=""

# Google Cloud → APIs & Services → Credentials → OAuth client ID (Web).
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# DEVELOPMENT ONLY. Enables a passwordless "sign in as any email" button so
# multi-user behaviour can be tested without Google credentials. It is ignored
# in production builds, but never set it on a deployed environment.
ALLOW_DEV_LOGIN="false"
